<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==================== 浅色主题 token ====================
         所有画笔都通过 DynamicResource 引用，切换主题时整体替换本字典即可。
         对比度（WCAG AA 4.5:1）均已实测，见 design/DESIGN.md -->

    <SolidColorBrush x:Key="WinBg" Color="#F7F8FA" />
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAlt" Color="#FBFBFC" />
    <SolidColorBrush x:Key="InputBg" Color="#FFFFFF" />

    <SolidColorBrush x:Key="Border" Color="#E4E7EC" />
    <SolidColorBrush x:Key="BorderStrong" Color="#D4D9E0" />
    <SolidColorBrush x:Key="Divider" Color="#EFF1F5" />

    <SolidColorBrush x:Key="Text" Color="#14161A" />
    <SolidColorBrush x:Key="Text2" Color="#5F6875" />
    <SolidColorBrush x:Key="Text3" Color="#8A929E" />

    <SolidColorBrush x:Key="Track" Color="#EBEEF2" />
    <SolidColorBrush x:Key="SegBg" Color="#EDEFF3" />
    <SolidColorBrush x:Key="SegActive" Color="#FFFFFF" />

    <!-- 强调色：Accent 用于图标/链接（在白底 5.2:1），
         AccentSolid 用于实心按钮底（配白字 5.2:1） -->
    <SolidColorBrush x:Key="Accent" Color="#2563EB" />
    <SolidColorBrush x:Key="AccentSolid" Color="#2563EB" />
    <SolidColorBrush x:Key="AccentSolidHover" Color="#1D4ED8" />
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" />

    <!-- 状态语义色：只用于数值与状态标记，不用于按钮 -->
    <SolidColorBrush x:Key="Success" Color="#14804A" />
    <SolidColorBrush x:Key="Caution" Color="#A9640C" />
    <SolidColorBrush x:Key="Danger" Color="#C0392B" />
    <SolidColorBrush x:Key="Muted" Color="#8A929E" />

    <SolidColorBrush x:Key="Hover" Color="#1A6B7385" />
    <SolidColorBrush x:Key="Press" Color="#2E6B7385" />

    <!-- DWM 磨砂不可用时的兜底实色 -->
    <SolidColorBrush x:Key="AcrylicFallback" Color="#F7F8FA" />
</ResourceDictionary>
