<Window x:Class="ElcBattery.App.Views.AlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="电量提醒"
        Width="360" Height="136"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Border CornerRadius="14" BorderThickness="0.5"
            BorderBrush="{DynamicResource BorderStrong}"
            Background="{DynamicResource Surface}">

        <!-- 浮层需要一点点阴影才能从桌面分离出来，这是唯一保留阴影的地方 -->
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="3" Direction="270" Opacity="0.18" />
        </Border.Effect>

        <Grid Margin="15,14,13,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 电量数字：底色用语义色，与主界面卡片保持一致 -->
            <Border x:Name="PercentBadge" Grid.Column="0" Width="60" Height="60" CornerRadius="30"
                    VerticalAlignment="Center">
                <TextBlock x:Name="PercentText" Text="--"
                           FontSize="21" FontWeight="SemiBold" Foreground="#FFFFFF"
                           Typography.NumeralAlignment="Tabular"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Column="1" Margin="14,0,8,0" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Text="电量偏低"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text}" />
                <TextBlock x:Name="DeviceText" Text="设备"
                           FontSize="12" Margin="0,4,0,0"
                           Foreground="{DynamicResource Text2}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="HintText" Text="建议尽快充电"
                           FontSize="11" Margin="0,3,0,0"
                           Foreground="{DynamicResource Text3}"
                           TextWrapping="Wrap" LineHeight="16" />
            </StackPanel>

            <Button Grid.Column="2" Width="24" Height="24"
                    VerticalAlignment="Top" HorizontalAlignment="Right"
                    Background="Transparent" BorderThickness="0"
                    Focusable="False" Cursor="Hand" ToolTip="关闭"
                    Click="Close_Click">
                <Path Data="M4.4,4.4 L11.6,11.6 M11.6,4.4 L4.4,11.6"
                      Stroke="{DynamicResource Text3}" StrokeThickness="1.4"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Width="16" Height="16" Stretch="Uniform" />
            </Button>
        </Grid>
    </Border>
</Window>
